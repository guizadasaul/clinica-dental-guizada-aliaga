# Secretos de la API de staging. En el servidor: copiar a /opt/clinic/staging/.env
# y dejarlo con chmod 600. Guardar una copia en el gestor de contraseñas.
# Staging: credenciales SOLO de staging. Nunca una key de producción acá.
#
# Lo que no es secreto (APP_ENV, FRONTEND_URL, CORS_ORIGINS, TRUST_PROXY_HOPS,
# DATABASE_SSL_CA, PORT, NODE_ENV) está fijo en docker-compose.yml.
# Qué hace cada variable: api/.env.example.

# Session pooler del Supabase de staging (Connect → Session pooler, puerto
# 5432), tal cual lo muestra el Dashboard: SIN "?sslmode=..." — el TLS
# verificado lo da DATABASE_SSL_CA (fija en docker-compose.yml).
DATABASE_URL=

SUPABASE_URL=https://lrvzfcwsvedigqsiehnf.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Resend: API key propia de este ambiente.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_REPLY_TO=

# BANECO (cobro con QR). Credenciales reales: cada QR es un cobro real.
BANECO_API_URL=
BANECO_USERNAME=
BANECO_PASSWORD=
BANECO_AES_KEY=
BANECO_ACCOUNT=
# BANECO_BRANCH_CODE=

# Chatbot (Groq): API key propia de este ambiente.
GROQ_API_KEY=
CHATBOT_ENABLED=false
