# Prisma does not auto-load this file — see prisma.config.ts for `import "dotenv/config"`.

DATABASE_URL="postgresql://user:password@localhost:5432/dbname?schema=public"

# Supabase project URL (Settings → API → Project URL)
SUPABASE_URL=""

# Only needed if the Supabase project still signs tokens with the legacy HS256 shared secret
# (Settings → API → JWT Keys). Check: curl $SUPABASE_URL/auth/v1/.well-known/jwks.json —
# empty "keys" array means legacy HS256 and this must be set to the JWT secret shown there.
# SUPABASE_JWT_SECRET=""

# API Market de BANECO (cobro con QR, CLI-11). Ambiente de certificación:
# https://apimktdesa.baneco.com.bo/ApiGateway/ — el banco provee la URL de
# producción, usuario/contraseña, la llave AES (32 caracteres) y el número
# de cuenta a acreditar por separado.
BANECO_API_URL=""
BANECO_USERNAME=""
BANECO_PASSWORD=""
BANECO_AES_KEY=""
BANECO_ACCOUNT=""
# Opcional — máximo 5 caracteres, ver doc de generateQR.
# BANECO_BRANCH_CODE=""
