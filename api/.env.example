# Prisma does not auto-load this file — see prisma.config.ts for `import "dotenv/config"`.

# ─────────────────────────────────────────────────────────────────────────────
# Este archivo documenta TODAS las variables de la API, sin valores reales.
#   - Desarrollo local: copiarlo a api/.env (gitignoreado).
#   - Staging y producción: el .env vive solo en el servidor
#     (/opt/clinic/<ambiente>/.env, chmod 600) y en el gestor de contraseñas;
#     nunca en git. Cada ambiente tiene sus propias credenciales: proyecto de
#     Supabase, keys de Resend y Groq, etc. — ver deploy/README.md.
# Clasificación: [secreta] nunca sale del backend ni se loguea · [privada]
# config interna sin riesgo si se filtra · [pública] termina visible igual
# (URLs, orígenes).
# ─────────────────────────────────────────────────────────────────────────────

# [pública] "local" | "staging" | "production". Hoy solo lo usa
# prisma/seed-demo.ts para negarse a correr en producción.
# APP_ENV="local"

# [privada] Puerto HTTP. Sin setear: 2999 (desarrollo). La imagen de
# producción (api/Dockerfile) fija 3000, que es el que espera el reverse proxy.
# PORT=2999

# [privada] Cuántos proxies de confianza hay delante de la API, para que
# req.ip (y con eso el rate limit) sea la IP real del cliente y no la del
# proxy. Staging/producción: 1 (Caddy, que recibe la IP real de Cloudflare).
# Desarrollo local sin proxy: dejarla sin setear — confiar en
# X-Forwarded-For sin proxy delante permite falsificar la IP.
# TRUST_PROXY_HOPS=1

# [secreta] Postgres de la app. Local: el de Docker. Staging/producción: el
# Postgres del proyecto Supabase de cada ambiente, por el Session pooler
# (Supabase → Connect → Session pooler, puerto 5432, IPv4).

DATABASE_URL="postgresql://user:password@localhost:5432/dbname?schema=public"

# [pública] Supabase project URL (Settings → API → Project URL)
SUPABASE_URL=""

# Only needed if the Supabase project still signs tokens with the legacy HS256 shared secret
# (Settings → API → JWT Keys). Check: curl $SUPABASE_URL/auth/v1/.well-known/jwks.json —
# empty "keys" array means legacy HS256 and this must be set to the JWT secret shown there.
# SUPABASE_JWT_SECRET=""

# service_role key (Settings → API → Project API keys). Server-only, nunca exponer al
# frontend. Se usa para confirmar el teléfono de un paciente como credencial de login
# (phone + password) vía Admin API, sin pasar por el flujo de SMS/OTP de Supabase — el
# número ya lo verificó el doctor al cargarlo en la ficha del paciente.
SUPABASE_SERVICE_ROLE_KEY=""

# Usuarios de demo (un doctor, un paciente y un administrador) para evaluar el
# proyecto en una base limpia. Descomentar en un clon nuevo; NO activar en una
# base real (ya tiene su propio administrador y el seed lo omitiría).
# Las credenciales de esas cuentas se entregan aparte, no están en el repo.
# SEED_DEMO="true"

# API Market de BANECO (cobro con QR, CLI-11). La URL de "ambiente de
# certificación" que trae el PDF de la doc (apimktdesa.baneco.com.bo) devuelve
# "Usuario no habilitado para uso de apis" incluso con credenciales válidas —
# en la práctica, la cuenta habilitada usa directamente la URL de producción:
# https://apimkt.baneco.com.bo/ApiGateway/ (confirmado en vivo, sin headers
# extra aparte de userName/password). Usuario/contraseña/llave AES (32
# caracteres)/número de cuenta los provee el banco por separado.
BANECO_API_URL=""
BANECO_USERNAME=""
BANECO_PASSWORD=""
BANECO_AES_KEY=""
BANECO_ACCOUNT=""
# Opcional — máximo 5 caracteres, ver doc de generateQR.
# BANECO_BRANCH_CODE=""

# Resend (envío de emails de invitación, CLI-13, CLI-38).
# RESEND_FROM_EMAIL tiene que ser una casilla de un dominio verificado en
# Resend (Dashboard → Domains) — sin eso, Resend rechaza el envío con 403.
# onboarding@resend.dev (el dominio compartido de prueba de Resend) solo
# sirve para mandar a la casilla dueña de la cuenta, no a un destinatario
# cualquiera; no usarlo fuera de pruebas locales propias.
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
# Opcional — casilla real donde deben llegar las respuestas de los
# pacientes, si RESEND_FROM_EMAIL es una dirección noreply@.
# RESEND_REPLY_TO=""

# Origen del frontend, para armar el link de invitación (/invitacion/:token)
# y como fallback de CORS_ORIGINS si esa no está seteada.
FRONTEND_URL="http://localhost:4200"

# Lista blanca de CORS (CLI-36), CSV con uno o más orígenes exactos
# (esquema + host + puerto, sin barra final), ej:
# CORS_ORIGINS="https://clinica-guizada-aliaga.com,https://www.clinica-guizada-aliaga.com"
# Si no está seteada, se usa FRONTEND_URL; si tampoco, http://localhost:4200.
# CORS_ORIGINS=""

# Rate limiting de los endpoints públicos de escritura (CLI-36), en
# cantidad de requests por hora por IP. El storage es en memoria (default de
# @nestjs/throttler): se resetea al reiniciar el proceso y es por proceso,
# no compartido entre varias instancias. Sin setear, se usan estos mismos
# valores como default — subilos en dev si necesitás probar un formulario
# más de esas veces por hora.
# THROTTLE_TESTIMONIALS_PER_HOUR=3
# THROTTLE_APPOINTMENTS_HOLD_PER_HOUR=5
# THROTTLE_APPOINTMENTS_CONTACT_PER_HOUR=10
# THROTTLE_REGISTER_PHONE_PER_HOUR=5

# Tipo de cambio USD→BOB para tratamientos en dólares (Implante, CLI-19).
# api.factura.bo/ExchangeRate es pública y gratuita, sin API key — no hace
# falta configurar nada acá salvo que se quiera apuntar a otra URL.
# FACTURA_BO_URL="https://api.factura.bo/ExchangeRate"

# Chatbot con IA (épica CLI-81). El LLM es GPT-OSS vía Groq; la API key vive
# solo en el backend — el frontend y WhatsApp nunca hablan con Groq. Se leen
# de forma perezosa: sin GROQ_API_KEY la app arranca igual, solo el chat
# responde con el mensaje de "no disponible".
# Key: console.groq.com → API Keys.
GROQ_API_KEY=""
# Opcionales (estos son los defaults):
# GROQ_MODEL="openai/gpt-oss-120b"        # o "openai/gpt-oss-20b", más barato
# GROQ_BASE_URL="https://api.groq.com/openai/v1"  # cualquier endpoint compatible con OpenAI
# GROQ_TIMEOUT_MS=20000
# GROQ_MAX_COMPLETION_TOKENS=1024         # gpt-oss cuenta acá también su razonamiento
# GROQ_REASONING_EFFORT="low"             # low | medium | high
# Kill switch del chatbot (lo consumen los endpoints, CLI-89): "true" para habilitarlo.
# CHATBOT_ENABLED="false"
# Memoria y retención del chat (opcionales, estos son los defaults):
# CHAT_CONTEXT_MESSAGES=12        # mensajes previos que se le mandan al modelo
# CHAT_CONTEXT_MAX_CHARS=8000     # tope de caracteres de ese contexto
# CHAT_MAX_TOOL_ITERATIONS=4      # vueltas de tool calling por respuesta
# CHAT_RETENTION_DAYS=30          # conversaciones sin actividad que se borran (cron 03:30 La Paz)
# Límites de uso del chat (CLI-89, opcionales, estos son los defaults). La
# cuota diaria sale de la base; los THROTTLE_* son por IP y en memoria.
# CHAT_DAILY_MESSAGES_USER=100    # mensajes por usuario logueado en 24 h
# CHAT_DAILY_MESSAGES_ANON=20     # mensajes por conversación anónima en 24 h
# THROTTLE_CHAT_USER_PER_MINUTE=10
# THROTTLE_CHAT_PUBLIC_PER_HOUR=30
