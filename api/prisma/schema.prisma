generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  odontologist
  patient
}

enum TreatmentApplicationType {
  general
  single_tooth
  multiple_teeth
  upper_arch
  lower_arch
  full_mouth
  soft_tissue
  frenulum
  prosthesis
  orthodontic
  unit
  box
}

enum TestimonialStatus {
  pending
  approved
  rejected
}

/// A cuántas piezas se aplica un diagnóstico del catálogo (CLI-40). `general`
/// son los hallazgos que no cuelgan de ningún diente (tejidos blandos,
/// supernumerario) — el frontend no muestra selector de piezas para esos.
enum DiagnosisScope {
  single_tooth
  multiple_teeth
  general
}

/// Eje extra que califica al diagnóstico. `black_class` = clasificación de
/// Black I–V (caries y obturaciones); `mobility_grade` = grados I–IV de
/// movilidad. Los valores viven en shared/validators/clinical-options.ts:
/// son fijos por la odontología, no configurables por la clínica.
enum DiagnosisModifier {
  none
  black_class
  mobility_grade
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// user_id se elimina (CLI-51) — nunca lo escribió ningún código (confirmado
/// en CLI-46) y era redundante con patient_id: como patients.user_id es 1:1,
/// nada impedía una cita con user_id=U y patient_id=P donde P.user_id≠U. Si
/// algún día hace falta el usuario de una cita, se deriva por
/// patient_id → patients.user_id, nunca se vuelve a guardar acá.
///
/// idx_one_active_appointment_slot solo protege el instante exacto de inicio
/// (CLI-47) — dos citas que se solapan parcialmente (una de 90 min a las
/// 9:00 y otra de 30 min a las 9:15) no chocan contra este índice. La
/// disponibilidad mostrada (getAvailability) sí las trata como solapadas;
/// falta una constraint de rango (EXCLUDE USING gist) para que la base
/// también lo impida ante una carrera entre dos requests concurrentes.
/// Deliberadamente fuera de alcance de CLI-47: el manejo de errores de
/// Prisma para una exclusion_violation de Postgres no está probado en este
/// proyecto (no hay ninguna constraint de este tipo todavía) y agregarla sin
/// verificar el código de error real arriesga romper el 409 limpio actual.
model appointments {
  id                       String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patient_id               String?     @db.Uuid
  treatment_id             String?     @db.Uuid
  appointment_datetime     DateTime    @unique(map: "idx_one_active_appointment_slot", where: raw("(((status)::text = 'held'::text) OR ((status)::text = 'confirmed'::text))")) @db.Timestamptz(6)
  /// Congelada al reservar (CLI-47) — snapshot de treatments.estimated_minutes
  /// en el momento del hold, o 30 (un slot) si no se especificó tratamiento.
  /// Cambiar estimated_minutes en el catálogo después no debe reinterpretar
  /// agendas ya reservadas, mismo criterio que los precios de quote_items.
  duration_minutes         Int         @default(30)
  status                   String      @default("scheduled") @db.VarChar(20)
  source                   String      @db.VarChar(20)
  whatsapp_name            String?     @db.VarChar(200)
  whatsapp_phone           String?     @db.VarChar(20)
  notes                    String?
  created_at               DateTime    @default(now()) @db.Timestamptz(6)
  hold_expires_at          DateTime?   @db.Timestamptz(6)
  /// @deprecated Reemplazado por guest_first_name/guest_last_name_paternal/guest_last_name_maternal (CLI-43). Se conserva sin escribir, como respaldo auditable de las filas anteriores.
  guest_full_name          String?     @db.VarChar(200)
  guest_first_name         String?     @db.VarChar(100)
  guest_last_name_paternal String?     @db.VarChar(100)
  guest_last_name_maternal String?     @db.VarChar(100)
  guest_phone              String?     @unique(map: "idx_one_active_appointment_guest_phone", where: raw("((((status)::text = 'held'::text) OR ((status)::text = 'confirmed'::text)) AND (guest_phone IS NOT NULL))")) @db.VarChar(20)
  guest_email              String?     @db.VarChar(255)
  baneco_qr_id             String?     @unique @db.VarChar(50)
  baneco_transaction_id    String?     @unique @db.VarChar(50)
  baneco_qr_image          String?
  payment_amount           Decimal?    @db.Decimal(10, 2)
  paid_at                  DateTime?   @db.Timestamptz(6)
  patients                 patients?   @relation(fields: [patient_id], references: [id], onUpdate: NoAction)
  treatments               treatments? @relation(fields: [treatment_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([appointment_datetime], map: "idx_appointments_datetime")
}

model clinical_exams {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patient_id       String   @db.Uuid
  tartar           Boolean  @default(false)
  saburra          Boolean  @default(false)
  bacterial_plaque Boolean  @default(false)
  halitosis        Boolean  @default(false)
  occlusion        String?  @db.VarChar(200)
  exam_date        DateTime @default(dbgenerated("CURRENT_DATE")) @db.Date
  created_at       DateTime @default(now()) @db.Timestamptz(6)
  patients         patients @relation(fields: [patient_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  // Un examen clínico por paciente por día — createClinicalExam hace upsert
  // sobre esta clave (CLI-39). Reenviar el paso 4 el mismo día actualiza en
  // vez de duplicar.
  @@unique([patient_id, exam_date], map: "clinical_exams_patient_id_exam_date_key")
}

model hygiene_habits {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patient_id         String   @unique @db.Uuid
  uses_toothbrush    Boolean  @default(false)
  brushing_frequency String?  @db.VarChar(100)
  uses_dental_floss  Boolean  @default(false)
  uses_toothpick     Boolean  @default(false)
  brushes_tongue     Boolean  @default(false)
  uses_mouthwash     Boolean  @default(false)
  updated_at         DateTime @default(now()) @db.Timestamptz(6)
  patients           patients @relation(fields: [patient_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model medical_history {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patient_id           String   @unique @db.Uuid
  has_allergies        Boolean  @default(false)
  kidney_problems      Boolean  @default(false)
  ulcers               Boolean  @default(false)
  rheumatism           Boolean  @default(false)
  heart_problems       Boolean  @default(false)
  diabetes             Boolean  @default(false)
  hypertension         Boolean  @default(false)
  hemorrhages          Boolean  @default(false)
  anemia               Boolean  @default(false)
  sti                  Boolean  @default(false)
  other_diseases       String?
  gestation_period     String?
  anesthesia_reactions Boolean?
  current_medications  String?
  updated_at           DateTime @default(now()) @db.Timestamptz(6)
  patients             patients @relation(fields: [patient_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// Desde CLI-40 esta tabla ya NO guarda el diagnóstico del paso 5 — solo las
/// filas que genera `createToothProcedure` al aplicar un tratamiento de
/// arcada/boca completa (`treatment_id NOT NULL`), que es lo que lee el
/// treatment-scope-picker. El diagnóstico vive en `dental_exams` /
/// `dental_exam_findings`, versionado y append-only.
model odontogram_entries {
  id                    String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patient_id            String      @db.Uuid
  tooth_number          Int
  tooth_type            String      @default("permanent") @db.VarChar(20)
  tooth_condition       String      @default("sano") @db.VarChar(30)
  diagnosis_description String
  xray_requested        Boolean     @default(false)
  treatment_id          String?     @db.Uuid
  custom_price          Decimal?    @db.Decimal(10, 2)
  entry_date            DateTime    @default(dbgenerated("CURRENT_DATE")) @db.Date
  notes                 String?
  created_at            DateTime    @default(now()) @db.Timestamptz(6)
  patients              patients    @relation(fields: [patient_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  treatments            treatments? @relation(fields: [treatment_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([patient_id, tooth_number], map: "idx_odontogram_patient_tooth")
}

/// Las 10 categorías clínicas del catálogo de diagnóstico (CLI-40). Cargadas
/// por el seed (upsert por `code`), igual que `treatments`.
model diagnosis_categories {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code          String      @unique @db.VarChar(50)
  name          String      @db.VarChar(150)
  display_order Int
  diagnoses     diagnoses[]
}

/// Catálogo real de diagnósticos de la clínica (CLI-40, 37 filas). Fuente
/// única — el frontend ya no hardcodea labels/colores. `is_active` es
/// soft-delete, igual que `treatments.is_active` en el seed.
model diagnoses {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  category_id          String                 @db.Uuid
  code                 String                 @unique @db.VarChar(50)
  name                 String                 @db.VarChar(150)
  scope                DiagnosisScope
  modifier             DiagnosisModifier      @default(none)
  color                String                 @db.VarChar(7)
  display_order        Int
  is_active            Boolean                @default(true)
  diagnosis_categories diagnosis_categories   @relation(fields: [category_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  dental_exam_findings dental_exam_findings[]

  @@index([category_id], map: "idx_diagnoses_category")
}

/// Snapshot inmutable del examen dental de un paciente (CLI-40). Cada
/// guardado del paso 5 crea una versión nueva — nunca se actualiza ni se
/// borra una fila existente (append-only, ver createDentalExam en el repo).
model dental_exams {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patient_id           String                 @db.Uuid
  version              Int
  recorded_by          String                 @db.Uuid
  recorded_at          DateTime               @default(now()) @db.Timestamptz(6)
  change_reason        String?
  notes                String?
  patients             patients               @relation(fields: [patient_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users                users                  @relation(fields: [recorded_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  dental_exam_findings dental_exam_findings[]

  @@unique([patient_id, version])
  @@index([patient_id, version(sort: Desc)], map: "idx_dental_exams_patient_version_desc")
}

/// Un hallazgo dentro de una versión de examen. `tooth_number` es NULL para
/// diagnósticos `general` (no cuelgan de ningún diente).
/// `application_group_id` agrupa las filas de un mismo hallazgo `multiple_teeth`
/// (mismo patrón que tooth_procedures.application_group_id).
model dental_exam_findings {
  id                   String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  exam_id              String       @db.Uuid
  diagnosis_id         String       @db.Uuid
  tooth_number         Int?
  tooth_type           String?      @db.VarChar(20)
  application_group_id String?      @db.Uuid
  modifier_value       String?      @db.VarChar(20)
  description          String?
  xray_requested       Boolean      @default(false)
  notes                String?
  dental_exams         dental_exams @relation(fields: [exam_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  diagnoses            diagnoses    @relation(fields: [diagnosis_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([exam_id], map: "idx_dental_exam_findings_exam")
  @@index([exam_id, tooth_number], map: "idx_dental_exam_findings_exam_tooth")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// El teléfono del paciente vive en users.phone (CLI-51) — patients.user_id
/// es 1:1, así que un patients.phone propio era una dependencia transitiva
/// de users.phone (violación de 3FN) y ya había divergido en producción.
model patients {
  id                             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                        String               @unique @db.Uuid
  first_name                     String               @db.VarChar(100)
  last_name_paternal             String               @db.VarChar(100)
  last_name_maternal             String?              @db.VarChar(100)
  birth_date                     DateTime?            @db.Date
  birth_place                    String?              @db.VarChar(150)
  sex                            String?              @db.VarChar(20)
  occupation                     String?              @db.VarChar(150)
  address                        String?
  emergency_contact_name         String?              @db.VarChar(200)
  emergency_contact_phone        String?              @db.VarChar(20)
  emergency_contact_relationship String?              @db.VarChar(100)
  consultation_reason            String?
  last_dentist_visit             DateTime?            @db.Date
  last_visit_treatment           String?
  family_history                 String?
  dni                            String?              @unique @db.VarChar(20)
  created_at                     DateTime             @default(now()) @db.Timestamptz(6)
  updated_at                     DateTime             @default(now()) @db.Timestamptz(6)
  appointments                   appointments[]
  clinical_exams                 clinical_exams[]
  hygiene_habits                 hygiene_habits?
  medical_history                medical_history?
  odontogram_entries             odontogram_entries[]
  dental_exams                   dental_exams[]
  // CLI-48: user_id es NOT NULL, así que SetNull era inalcanzable (Postgres
  // no puede poner NULL en una columna que no lo admite) — borrar un usuario
  // con ficha se rechaza en vez de dejar la ficha huérfana. La baja de
  // cuenta se maneja con users.is_active, no con borrado físico.
  users                          users                @relation(fields: [user_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  quotes                         quotes[]
  tooth_procedures               tooth_procedures[]
  xray_documents                 xray_documents[]
  patient_invites                patient_invites[]
}

model patient_invites {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patient_id String    @db.Uuid
  token_hash String    @unique @db.VarChar(64)
  channel    String    @db.VarChar(20)
  expires_at DateTime  @db.Timestamptz(6)
  used_at    DateTime? @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  patients   patients  @relation(fields: [patient_id], references: [id], onDelete: Cascade)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model payments {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quote_id       String   @db.Uuid
  amount         Decimal  @db.Decimal(10, 2)
  payment_method String?  @db.VarChar(50)
  receipt_number String   @unique @default(dbgenerated("('REC-'::text || lpad((nextval('receipt_number_seq'::regclass))::text, 6, '0'::text))")) @db.VarChar(20)
  payment_date   DateTime @default(now()) @db.Timestamptz(6)
  notes          String?
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  quotes         quotes   @relation(fields: [quote_id], references: [id], onUpdate: NoAction)
}

/// Precio y tratamiento compartidos por un grupo de quote_items que
/// corresponden a la misma aplicación multiple_teeth (CLI-45). Antes ese
/// precio vivía en una fila arbitraria de quote_items (la del diente de
/// número más bajo, con las demás facturando 0) — violación de 2FN:
/// unit_price/subtotal dependían de (quote_id, application_group_id), no
/// del diente. Borrar el grupo entero (quote_items.onDelete: Cascade sobre
/// application_group_id) es la única forma soportada de borrarlo — ver
/// removeItemGroup.
model application_groups {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// NULL para un grupo de tooth_procedures (CLI-53) — esos no cuelgan de
  /// ningún presupuesto, son procedimientos ya realizados.
  quote_id         String?            @db.Uuid
  treatment_id     String             @db.Uuid
  unit_price       Decimal            @db.Decimal(10, 2)
  subtotal         Decimal            @db.Decimal(10, 2)
  currency         String             @default("BOB") @db.VarChar(3)
  exchange_rate    Decimal?           @db.Decimal(12, 5)
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  quotes           quotes?            @relation(fields: [quote_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  treatments       treatments         @relation(fields: [treatment_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  quote_items      quote_items[]
  tooth_procedures tooth_procedures[]

  @@index([quote_id], map: "idx_application_groups_quote")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model quote_items {
  id                   String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quote_id             String              @db.Uuid
  treatment_id         String              @db.Uuid
  tooth_number         Int?
  application_group_id String?             @db.Uuid
  /// NULL cuando application_group_id está seteado (CLI-45) — el precio de
  /// una aplicación multiple_teeth vive una sola vez en application_groups,
  /// no repetido/mentido por fila. Solo las filas sueltas (single_tooth,
  /// general) tienen su propio precio acá.
  unit_price           Decimal?            @db.Decimal(10, 2)
  quantity             Int                 @default(1)
  subtotal             Decimal?            @db.Decimal(10, 2)
  currency             String?             @db.VarChar(3)
  exchange_rate        Decimal?            @db.Decimal(12, 5)
  quotes               quotes              @relation(fields: [quote_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  treatments           treatments          @relation(fields: [treatment_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  application_groups   application_groups? @relation(fields: [application_group_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([quote_id], map: "idx_quote_items_quote")
  @@index([application_group_id], map: "idx_quote_items_application_group")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model quotes {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patient_id         String               @db.Uuid
  total_amount       Decimal              @default(0) @db.Decimal(10, 2)
  total_paid         Decimal              @default(0) @db.Decimal(10, 2)
  status             String               @default("pending") @db.VarChar(20)
  notes              String?
  created_at         DateTime             @default(now()) @db.Timestamptz(6)
  updated_at         DateTime             @default(now()) @db.Timestamptz(6)
  payments           payments[]
  quote_items        quote_items[]
  application_groups application_groups[]
  patients           patients             @relation(fields: [patient_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model tooth_procedures {
  id                   String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patient_id           String              @db.Uuid
  tooth_number         Int?
  application_group_id String?             @db.Uuid
  treatment_id         String              @db.Uuid
  /// NULL cuando application_group_id está seteado (CLI-53, mismo criterio
  /// que quote_items) — el precio de una aplicación multiple_teeth vive una
  /// sola vez en application_groups, no repetido/mentido por diente.
  price_charged        Decimal?            @db.Decimal(10, 2)
  /// Para aplicaciones por unidad/caja (elásticos, cera ortodóntica, CLI-41) — price_charged = quantity × treatments.base_price. 1 para el resto.
  quantity             Int                 @default(1)
  procedure_date       DateTime            @default(dbgenerated("CURRENT_DATE")) @db.Date
  surface_vestibular   Boolean             @default(false)
  surface_palatal      Boolean             @default(false)
  surface_mesial       Boolean             @default(false)
  surface_distal       Boolean             @default(false)
  surface_occlusal     Boolean             @default(false)
  notes                String?
  performed_by         String              @db.Uuid
  created_at           DateTime            @default(now()) @db.Timestamptz(6)
  patients             patients            @relation(fields: [patient_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users                users               @relation(fields: [performed_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  treatments           treatments          @relation(fields: [treatment_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  application_groups   application_groups? @relation(fields: [application_group_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  xray_documents       xray_documents[]

  @@index([procedure_date], map: "idx_tooth_procedures_date")
  @@index([patient_id, tooth_number], map: "idx_tooth_procedures_patient_tooth")
  @@index([application_group_id], map: "idx_tooth_procedures_application_group")
}

model testimonials {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String            @db.VarChar(100)
  /// Texto libre a propósito (CLI-36): el visitante describe su experiencia
  /// con sus propias palabras, a veces combinando varios tratamientos en una
  /// frase ("Limpieza, profilaxis y flúor") — no siempre mapea 1:1 a una fila
  /// del catálogo. treatment_code es la referencia real cuando corresponde;
  /// treatment queda como el texto tal cual lo escribió.
  treatment      String            @db.VarChar(150)
  /// FK opcional a treatments.code (CLI-53) — permite filtrar por tratamiento
  /// real sin que un rename rompa la referencia, sin forzar el formulario
  /// público a un selector rígido. Hoy ningún flujo la completa todavía.
  treatment_code String?           @db.VarChar(50)
  comment        String
  status         TestimonialStatus @default(pending)
  created_at     DateTime          @default(now()) @db.Timestamptz(6)
  updated_at     DateTime          @default(now()) @db.Timestamptz(6)
  treatments     treatments?       @relation(fields: [treatment_code], references: [code], onDelete: SetNull, onUpdate: NoAction)

  @@index([status], map: "idx_testimonials_status")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// Categorías del catálogo de tratamientos (CLI-41), espejo de
/// diagnosis_categories (CLI-40): las 8 categorías reales de la clínica
/// (Básicos, Operatoria dental, Periodoncia, Endodoncia, Cirugía oral,
/// Prótesis removible, Prótesis fija, Ortodoncia). Cargadas por el seed
/// (upsert por code).
model treatment_categories {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code          String       @unique @db.VarChar(50)
  name          String       @db.VarChar(150)
  display_order Int
  treatments    treatments[]
}

model treatments {
  id                      String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Clave estable del catálogo (CLI-41) — el seed hace upsert por code, no
  /// por name, así que renombrar un tratamiento no duplica la fila ni la
  /// desactiva por accidente.
  code                    String                   @unique @db.VarChar(50)
  name                    String                   @unique @db.VarChar(200)
  description             String?
  base_price              Decimal                  @db.Decimal(10, 2)
  estimated_minutes       Int                      @default(30)
  application_type        TreatmentApplicationType @default(single_tooth)
  currency                String                   @default("BOB") @db.VarChar(3)
  category_id             String                   @db.Uuid
  display_order           Int                      @default(0)
  is_active               Boolean                  @default(true)
  is_default_consultation Boolean                  @unique(map: "idx_one_default_consultation", where: raw("(is_default_consultation = true)")) @default(false)
  created_at              DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at              DateTime                 @default(now()) @db.Timestamptz(6)
  appointments            appointments[]
  odontogram_entries      odontogram_entries[]
  quote_items             quote_items[]
  application_groups      application_groups[]
  tooth_procedures        tooth_procedures[]
  testimonials            testimonials[]
  treatment_categories    treatment_categories     @relation(fields: [category_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model users {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  auth_user_id     String?            @unique @db.Uuid
  email            String?            @unique @db.VarChar(255)
  display_name     String?            @db.VarChar(255)
  photo_url        String?
  phone            String?            @db.VarChar(20)
  is_active        Boolean            @default(true)
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  updated_at       DateTime           @default(now()) @db.Timestamptz(6)
  role             UserRole           @default(patient)
  patients         patients?
  tooth_procedures tooth_procedures[]
  dental_exams     dental_exams[]
}

/// Sin código todavía — CLI-53. Notas para cuando se implemente:
/// * google_drive_url se elimina a propósito (CLI-53, violación de 3FN): es
///   derivable de google_drive_file_id vía plantilla fija
///   (https://drive.google.com/file/d/{fileId}/view). Calcularla en el
///   mapper/servicio al leer, nunca guardarla — guardar las dos permitía que
///   discreparan (resubir un archivo actualiza una columna y no la otra).
/// * patient_id debe coincidir con tooth_procedures.patient_id cuando
///   tooth_procedure_id está seteado (CLI-53) — no hay constraint de base
///   para esto (requiere trigger, y no hay ninguno en el schema todavía) así
///   que el servicio que cree filas acá tiene que derivar patient_id del
///   tooth_procedure en vez de aceptarlo como input independiente.
model xray_documents {
  id                   String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patient_id           String            @db.Uuid
  tooth_procedure_id   String?           @db.Uuid
  google_drive_file_id String            @unique @db.VarChar(200)
  thumbnail_url        String?
  file_name            String?           @db.VarChar(255)
  taken_date           DateTime?         @db.Date
  notes                String?
  uploaded_at          DateTime          @default(now()) @db.Timestamptz(6)
  patients             patients          @relation(fields: [patient_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tooth_procedures     tooth_procedures? @relation(fields: [tooth_procedure_id], references: [id], onUpdate: NoAction)
}
